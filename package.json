{
  "name": "coparenting-app",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "astro dev --port 8040",
    "build": "astro build",
    "preview": "astro preview --port 8040",
    "check": "astro check && svelte-check --fail-on-warnings",
    "test": "vitest run",
    "smoke": "node scripts/smoke-demo.mjs",
    "dev:baza": "BAZA=lokalno astro dev --port 8040",
    "test:baza": "supabase test db",
    "baza": "supabase start -x realtime,edge-runtime,logflare,vector,imgproxy,supavisor",
    "baza:stop": "supabase stop",
    "smoke:nalog": "node scripts/smoke-nalog.mjs"
  },
  "dependencies": {
    "@astrojs/svelte": "^9.1.2",
    "@fontsource/dm-mono": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@supabase/supabase-js": "~2.118.0",
    "astro": "~7.4.4",
    "svelte": "^5.57.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@types/node": "^24.19.2",
    "supabase": "~2.122.1",
    "svelte-check": "^4.7.8",
    "typescript": "~6.0.3",
    "vitest": "^5.1.0"
  }
}
